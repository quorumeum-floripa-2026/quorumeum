_bitcoind() {
    local cmd="${words[1]}"
    local -a opts

    case "${words[CURRENT]}" in
        -conf=*|-pid=*|-loadblock=*|-rpccookiefile=*|-wallet=*)
            _files
            return
            ;;
        -datadir=*)
            _files -/
            return
            ;;
        -*=*)
            return
            ;;
    esac

    if [[ -z "${words[CURRENT]}" || "${words[CURRENT]}" == -* ]]; then
        opts=(${(f)"$($cmd -help 2>&1 | awk '$1 ~ /^-/ { sub(/=.*/, "="); print $1 }')"})
        _describe 'options' opts
    fi
}

_bitcoind "$@"
