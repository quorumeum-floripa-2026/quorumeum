_bitcoin_tx() {
    local cmd="${words[1]}"
    local -a opts commands

    case "${words[CURRENT]}" in
        load=*:*)
            _files
            return
            ;;
        load=*|set=*)
            _files
            return
            ;;
        *=*)
            return
            ;;
    esac

    if [[ $CURRENT == 2 || ( "${words[CURRENT-1]}" != "-create" && "${words[CURRENT-1]}" == -* ) ]]; then
        opts=(${(f)"$($cmd -help 2>&1 | awk '/^  -/ { sub(/=.*/, "="); print $1 }')"})
        _describe 'options' opts
    else
        commands=(${(f)"$($cmd -help 2>&1 | sed -e '1,/Commands:/d' -e 's/=.*/=/' -e '/^  [a-z]/ !d' -e 's/^  //')"})
        _describe 'commands' commands
    fi
}

_bitcoin_tx "$@"
